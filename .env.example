DATABASE_URL="postgresql://postgres:postgres@localhost:5432/makanza?schema=public"
API_PORT=4100
ADMIN_ORIGIN=http://localhost:3001
CUSTOMER_MOBILE_ORIGIN=
OPERATIONS_MOBILE_ORIGIN=
RIDER_MAX_PICKUP_KM=12
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Dedicated encryption key for rider and guarantor NINs (keep stable; do not rotate without migrating stored data).
RIDER_PII_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
DELIVERY_OTP_SECRET=replace-with-a-random-delivery-secret-of-at-least-32-characters
DEMO_MODE=true
DEMO_PASSWORD=smile2026@@
ALLOW_ADMIN_SEED=false
ALLOW_PRODUCTION_ADMIN_BOOTSTRAP=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_CONFIRMATION=
PAYMENT_PROVIDER=mock
# Paystack test key locally; use the live key only in a separately configured production environment.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Infobip 2FA: active signup phone OTP provider (SMS). Use the API base URL shown in your Infobip account.
# HTTPS API hostname from Infobip; do not include an endpoint path.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
INFOBIP_2FA_SENDER=
# WhatsApp sender registered with Infobip (international number; a leading + is optional).
INFOBIP_WHATSAPP_SENDER=
# Exact approved template name, not the WABA or template ID.
INFOBIP_WHATSAPP_TEMPLATE_NAME=smile_verify
# Exact language/locale configured for the template in Infobip (for example, en).
INFOBIP_WHATSAPP_TEMPLATE_LANGUAGE=en
# Temporarily enable on staging to log sanitized Infobip status fields in the customer app.
PHONE_VERIFICATION_DEBUG_RESPONSE=false
# Cloudinary signed vendor image uploads. Keep API_SECRET server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Twilio Verify is retained but inactive; signup verification does not call it.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Local development only. Never enable in production; bypass signups are tagged as demo accounts.
PHONE_VERIFICATION_BYPASS=false
# Non-production shared signup OTP for customer and operations app testing; production always uses Infobip.
PHONE_VERIFICATION_TEST_CODE=
EXPO_ACCESS_TOKEN=
# One server key may be used for both APIs if it is restricted to Routes and Geocoding.
# MAPS_API_KEY is a legacy fallback; the dedicated variables below are preferred.
MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
GOOGLE_MAPS_PLACES_API_KEY=
GOOGLE_ROUTES_MAX_ORIGINS=25
GOOGLE_MAPS_ALLOW_STRAIGHT_LINE_FALLBACK=false
