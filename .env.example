DATABASE_URL="postgresql://postgres:postgres@localhost:5432/makanza?schema=public"
API_PORT=4100
RIDER_MAX_PICKUP_KM=12
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
DELIVERY_OTP_SECRET=replace-with-a-random-delivery-secret-of-at-least-32-characters
DEMO_MODE=true
DEMO_PASSWORD=
PAYMENT_PROVIDER=mock
# Paystack test key locally; use the live key only in a separately configured production environment.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Infobip 2FA: active signup phone OTP provider (SMS). Use the API base URL shown in your Infobip account.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
INFOBIP_2FA_SENDER=
# Cloudinary signed vendor image uploads. Keep API_SECRET server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Twilio Verify is retained but inactive; signup verification does not call it.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Local development only. Never enable in production; bypass signups are tagged as demo accounts.
PHONE_VERIFICATION_BYPASS=false
EXPO_ACCESS_TOKEN=
MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
GOOGLE_ROUTES_MAX_ORIGINS=25
GOOGLE_MAPS_ALLOW_STRAIGHT_LINE_FALLBACK=false
