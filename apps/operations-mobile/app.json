{
  "expo": {
    "name": "Smile Operations",
    "slug": "smile-operations",
    "scheme": "smile-ops",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": { "barStyle": "dark-content", "backgroundColor": "#ffffff", "translucent": false },
    "newArchEnabled": true,
    "plugins": ["expo-secure-store", ["expo-location", { "locationWhenInUsePermission": "Smile uses your location while you are online or completing an assigned delivery." }], ["expo-image-picker", { "photosPermission": "Smile lets you choose store and product photos." }]],
    "ios": { "supportsTablet": true, "bundleIdentifier": "ng.smile.operations" },
    "android": { "package": "ng.smile.operations", "adaptiveIcon": { "backgroundColor": "#194c3a" } }
  }
}
