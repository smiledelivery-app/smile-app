# Leave blank to use the platform default in src/config/env.ts.
# For a physical phone, use your computer's LAN IP, e.g. http://192.168.1.20:4100/api/v1
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_MAPS_ENABLED=false
# Native SDK keys are embedded in the app binary. Restrict each key to this app's package/bundle id and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
