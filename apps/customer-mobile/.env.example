EXPO_PUBLIC_API_URL=http://localhost:4100/api/v1
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_ENABLE_PUSH=true
# Required for Android native push delivery. Set this in the Expo/EAS project dashboard as a secret value.
# The file should be the downloaded google-services.json from the matching Firebase project.
GOOGLE_SERVICES_JSON=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
